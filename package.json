{
  "name": "clientweave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --check package.json tsconfig.json next.config.ts drizzle.config.ts playwright.config.ts vitest.config.ts eslint.config.mjs src tests .github",
    "format:write": "prettier --write package.json tsconfig.json next.config.ts drizzle.config.ts playwright.config.ts vitest.config.ts eslint.config.mjs src tests .github",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:concurrency": "vitest run --project concurrency",
    "test:e2e": "playwright test",
    "test:performance": "PERFORMANCE_PROFILE=local playwright test tests/e2e/performance-targets.spec.ts",
    "test:webmcp": "vitest run --project webmcp",
    "test:security": "vitest run --project security",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contract:check": "tsx scripts/check-contracts.ts && tsx scripts/check-agent-capabilities.ts",
    "validate": "corepack pnpm format && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm contract:check && corepack pnpm test:unit && corepack pnpm test:property && corepack pnpm test:integration && corepack pnpm test:concurrency && corepack pnpm test:e2e && corepack pnpm test:webmcp && corepack pnpm test:security"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.87.0",
    "drizzle-orm": "^0.44.5",
    "next": "^16.0.0",
    "pino": "^10.0.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.0",
    "puppeteer": "^24.17.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0"
  }
}
